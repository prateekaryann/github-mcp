# GitHub MCP Server Configuration

# Base directory for git operations (all repo_path params are sandboxed here)
WORK_DIR=~/projects

# Read-only mode: only expose list/view/search tools (blocks all write operations)
READ_ONLY=false

# Log file path for audit trail
LOG_FILE=mcp_audit.log

# Server transport: "stdio" for local Claude Desktop/Code, "sse" for remote/tunnel
MCP_TRANSPORT=stdio

# Port for SSE transport (only used when MCP_TRANSPORT=sse)
MCP_PORT=8080

# API key for SSE transport authentication (required when using SSE)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
